# Build stage: compile gitea-mcp from source (Go 1.27+)
FROM golang:1.27-alpine AS build
RUN apk add --no-cache git

# Pin the wrapped server to a specific commit; override at build time to track main:
#   docker compose build --build-arg GITEA_MCP_REF=main gitea-mcp
ARG GITEA_MCP_REF=21f40d77ee66ec332da07d721df69579638b2142
RUN git clone https://gitea.com/gitea/gitea-mcp.git /src \
 && cd /src \
 && git checkout ${GITEA_MCP_REF}
WORKDIR /src
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/gitea-mcp .

# Runtime: supergateway wrapping the static gitea-mcp binary
FROM node:22-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Pin with: docker compose build --build-arg SUPERGATEWAY_VERSION=x.y.z
ARG SUPERGATEWAY_VERSION=4.1.0
RUN npm install -g supergateway@${SUPERGATEWAY_VERSION}

COPY --from=build /out/gitea-mcp /usr/local/bin/gitea-mcp

# Static Go binary; it only reads /usr/local/bin and talks to the Gitea host over HTTPS
USER node
EXPOSE 8000
ENTRYPOINT ["supergateway"]
