MEALIE_BASE_URL=https://mealie.example.com
MEALIE_API_KEY=your-mealie-api-token

# Optional: pin the Mealie MCP server to a specific commit instead of the default branch
# MEALIE_MCP_SOURCE=git+https://github.com/rldiao/mealie-mcp-server@<commit-sha>

# AnyList account credentials (https://www.anylist.com)
ANYLIST_USERNAME=you@example.com
ANYLIST_PASSWORD=your-anylist-password
# Default shopping list, used when a tool call doesn't pass list_name explicitly.
# Any valid list name works; the server errors on list-less calls without it.
ANYLIST_LIST_NAME=Groceries

# Gitea instance (any Gitea URL: https://gitea.com, self-hosted, etc.)
# Create a token under Settings -> Applications -> Generate New Token in Gitea.
GITEA_HOST=https://gitea.example.com
GITEA_ACCESS_TOKEN=your-gitea-personal-access-token

# Optional: hide write tools (create/update/delete) from the agent
# GITEA_READONLY=true
# Optional: comma-separated tool scopes to expose (e.g. "issue,pull_request,repository")
# GITEA_SCOPES=
# Optional: comma-separated individual tool names to expose
# GITEA_TOOLS=

# Actual Budget (self-hosted server, default port 5006). The URL must be
# reachable from inside the Docker network and include the scheme:
# http://<lan-ip-or-hostname>:5006, a container name on a shared network, or
# http://host.docker.internal:5006 when Actual runs on the Docker host (then
# enable extra_hosts on the actual-mcp service in docker-compose.yml).
ACTUAL_SERVER_URL=http://actual.example.com:5006
# Login password of the Actual server (not the budget encryption password)
ACTUAL_PASSWORD=your-actual-server-password
# Optional: Settings -> Show advanced settings -> Sync ID in Actual.
# When unset the MCP server uses the first budget on the server.
# ACTUAL_BUDGET_SYNC_ID=your-budget-sync-id
# Optional: only for end-to-end encrypted budget files
# ACTUAL_BUDGET_ENCRYPTION_PASSWORD=your-budget-encryption-password
