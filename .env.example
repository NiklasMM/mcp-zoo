MEALIE_BASE_URL=https://mealie.example.com
MEALIE_API_KEY=your-mealie-api-token

# Optional: pin the Mealie MCP server to a specific commit instead of the default branch
# MEALIE_MCP_SOURCE=git+https://github.com/rldiao/mealie-mcp-server@<commit-sha>

# AnyList account credentials (https://www.anylist.com)
ANYLIST_USERNAME=you@example.com
ANYLIST_PASSWORD=your-anylist-password
# Default shopping list; defaults to "Groceries" if unset
ANYLIST_LIST_NAME=Groceries
