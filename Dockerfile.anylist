FROM node:22-slim

# git for cloning the wrapped server; python3/make/g++ as a fallback build
# toolchain for native npm modules (better-sqlite3, bcrypt ship prebuilds)
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

# Pin with: docker compose build --build-arg SUPERGATEWAY_VERSION=x.y.z
ARG SUPERGATEWAY_VERSION=4.1.0
RUN npm install -g supergateway@${SUPERGATEWAY_VERSION}

WORKDIR /app
# Pin the wrapped server to a specific commit; override at build time to track main:
#   docker compose build --build-arg ANYLIST_MCP_REF=main anylist-mcp
ARG ANYLIST_MCP_REF=60763f644f85b39838b886c26251d1ff91edf23e
RUN git clone --recurse-submodules https://github.com/bobby060/anylist-mcp.git . \
 && git checkout ${ANYLIST_MCP_REF} \
 && git submodule update --init --recursive \
 && npm ci --omit=dev

# Plain-JS server (no build step); it only reads /app and talks to AnyList over HTTPS
USER node

EXPOSE 8000
