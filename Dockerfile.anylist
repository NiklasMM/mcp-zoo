FROM node:22-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g supergateway

WORKDIR /app
ARG ANYLIST_MCP_REF=main
RUN git clone https://github.com/davidashman/anylist-mcp.git . \
 && git checkout main \
 && npm install \
 && npm run build

EXPOSE 8000